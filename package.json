{
  "name": "grind",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "coach:eval": "tsx --env-file=.env.local scripts/coach-eval/run.ts",
    "replab": "node --env-file=.env.local watch/tools/replab.mjs",
    "watchreport": "node --env-file=.env.local watch/tools/watchreport.mjs",
    "test": "tsx --test scripts/__tests__/*.test.ts src/lib/utils/__tests__/*.test.ts src/lib/coach/__tests__/*.test.ts src/lib/cache/__tests__/*.test.ts src/lib/supabase/__tests__/*.test.ts src/components/coach/__tests__/*.test.ts src/components/onboarding/__tests__/*.test.ts src/components/health/recovery/__tests__/*.test.tssrc/lib/hooks/__tests__/*.test.ts src/lib/watch/__tests__/*.test.ts src/lib/body/__tests__/*.test.ts src/lib/reps/__tests__/*.test.ts src/lib/health/__tests__/*.test.ts src/lib/energy/__tests__/*.test.ts",
    "test:e2e": "playwright test",
    "migrations:check": "tsx --env-file=.env.local scripts/check-migrations.ts",
    "test:sql-parity": "tsx --test src/lib/utils/__tests__/sqlParity.test.ts src/lib/watch/__tests__/watchApi.db.test.ts",
    "typecheck": "tsc --noEmit",
    "test:scroll": "playwright test --config=e2e/scrolling.config.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.42",
    "@fontsource/bebas-neue": "^5.2.7",
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@garmin/fitsdk": "21.222.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "@vercel/analytics": "^2.0.1",
    "@zip.js/zip.js": "2.25.0",
    "ai": "^7.0.61",
    "fflate": "^0.8.3",
    "next": "16.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "esbuild": "0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "fake-indexeddb": "6.2.8",
    "sharp": "0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5"
  }
}
